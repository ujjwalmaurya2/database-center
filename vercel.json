{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/database",
      "destination": "/database.html"
    },
    {
      "source": "/storage",
      "destination": "/storage.html"
    },
    {
      "source": "/functions",
      "destination": "/functions.html"
    },
    {
      "source": "/api-docs",
      "destination": "/api.html"
    },
    {
      "source": "/sync",
      "destination": "/sync.html"
    },
    {
      "source": "/conflicts",
      "destination": "/conflicts.html"
    },
    {
      "source": "/recovery",
      "destination": "/recovery.html"
    },
    {
      "source": "/realtime",
      "destination": "/realtime.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/logs",
      "destination": "/logs.html"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ready",
      "destination": "/api/index.ts"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.ts"
    }
  ]
}
