{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ready",
      "destination": "/api/index.ts"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.ts"
    }
  ]
}
