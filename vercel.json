{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    },
    {
      "src": "/ready",
      "dest": "/api/index.ts"
    },
    {
      "src": "/metrics",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api-docs",
      "dest": "/public/api.html"
    },
    {
      "src": "/auth",
      "dest": "/public/auth.html"
    },
    {
      "src": "/dashboard",
      "dest": "/public/index.html"
    },
    {
      "src": "/database",
      "dest": "/public/database.html"
    },
    {
      "src": "/storage",
      "dest": "/public/storage.html"
    },
    {
      "src": "/functions",
      "dest": "/public/functions.html"
    },
    {
      "src": "/sync",
      "dest": "/public/sync.html"
    },
    {
      "src": "/conflicts",
      "dest": "/public/conflicts.html"
    },
    {
      "src": "/recovery",
      "dest": "/public/recovery.html"
    },
    {
      "src": "/realtime",
      "dest": "/public/realtime.html"
    },
    {
      "src": "/settings",
      "dest": "/public/settings.html"
    },
    {
      "src": "/logs",
      "dest": "/public/logs.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
